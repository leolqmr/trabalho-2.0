# Server
PORT=3000
NODE_ENV=development
API_PREFIX=sistema/api

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=banco de dados

# Usada diretamente pelo Prisma CLI (migrations/generate); a aplicação também aceita
# só as variáveis DB_* acima e monta essa URL em runtime (ver src/config/database.config.ts).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/banco de dados

# Swagger
SWAGGER_TITLE=api
SWAGGER_DESCRIPTION=apis
SWAGGER_VERSION=1.0.0
SWAGGER_PATH=api/docs

# Keycloak (deixe em branco para desabilitar auth, veja docs/auth.md)
# Valores abaixo já batem com o realm gerado em setup/realm.json e importado
# pelo serviço `keycloak` do docker-compose.yml.
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080/auth
KEYCLOAK_REALM=Local
KEYCLOAK_CLIENT_ID=sistema-back
KEYCLOAK_JWKS_CACHE_MAX_AGE=600000
KEYCLOAK_JWKS_TIMEOUT=5000
